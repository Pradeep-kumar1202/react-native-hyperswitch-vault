# Merchant server configuration — SERVER SIDE ONLY.
#
# Copy this file to example-server/.env and fill it in THERE. `.env` is gitignored; THIS file is
# committed, so it must never contain a real value — not even a commented-out one.
#
# Nothing here ever reaches the React Native app. The app receives only the client-safe session
# response (`vault_details`), never a secret key. Do not create a .env inside example/, and do not
# put any of these values in app code.

# Which Hyperswitch environment to create sessions against: sandbox | integration | production.
# Selects the default HYPERSWITCH_BASE_URL below. Optional; defaults to sandbox.
HYPERSWITCH_ENVIRONMENT=sandbox

# API host. Optional — leave blank to use the default for HYPERSWITCH_ENVIRONMENT
# (sandbox -> https://sandbox.hyperswitch.io).
HYPERSWITCH_BASE_URL=

# SECRET API key. Leave BLANK to run offline: the server then serves a structurally valid fake
# session, so the app can be exercised with no credentials. Setting it switches to live mode, in
# which HYPERSWITCH_PROFILE_ID and HYPERSWITCH_CUSTOMER_ID become required.
HYPERSWITCH_API_KEY=

# Profile the payment intent belongs to. Required in live mode.
HYPERSWITCH_PROFILE_ID=

# Customer the saved card will belong to. Required in live mode.
HYPERSWITCH_CUSTOMER_ID=

# The vault session is minted through a payment intent that is created but NEVER confirmed, so no
# money moves. These describe that intent. Both optional.
HYPERSWITCH_AMOUNT=1000
HYPERSWITCH_CURRENCY=USD

# Port this server listens on. Optional; defaults to 3001.
# Must match MERCHANT_SERVER_PORT in example/App.tsx.
PORT=3001

# Note: a PUBLISHABLE key is not needed here. The server calls POST /payments with the secret key,
# then POST /payments/session_tokens authenticated with that intent's own sdk_authorization — the
# same two calls hyperswitch-client-core's mockServer.js and SDK make. The publishable key already
# travels to the app inside the session's sdk_authorization.
